# Frontend API base URL.
#
# Leave empty for local dev with Vite proxy (/api -> http://localhost:3001).
# Set to your CloudFront/custom domain in deployed environments, e.g.:
# VITE_API_BASE_URL="https://turnier.example.com"
VITE_API_BASE_URL=""

# Authentication backend:
# - local: server /api/auth/* with HS256 token (dev/tests, legacy login).
# - cognito: AWS Cognito via aws-amplify (set the two ids below).
VITE_AUTH_PROVIDER="local"
# VITE_COGNITO_USER_POOL_ID="eu-central-1_xxxxxxxxx"
# VITE_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
