{
  "name": "client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "STORYBOOK_TESTS=true NODE_ENV=test dotenv -e ../server/.env.test -- vitest run",
    "test:watch": "vitest --config vitest.config.ts ../tests/client/unit",
    "test:unit": "vitest --config vitest.config.ts run ../tests/client/unit",
    "test:integration": "NODE_ENV=test dotenv -e ../server/.env.test -- vitest run ../tests/client/integration",
    "storybook": "storybook dev -p 6006 --config-dir ../tests/client/storybook",
    "build-storybook": "storybook build --config-dir ../tests/client/storybook"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@turnier-hub/shared": "file:../shared",
    "pinia": "^3.0.1",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "storybook": "^10.6.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
